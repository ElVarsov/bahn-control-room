DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments

# Claude access (docs/VOICE.md). Either an Anthropic key directly:
ANTHROPIC_API_KEY=
# ...or OpenRouter (the hackathon credits): leave ANTHROPIC_API_KEY empty and set these two.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Model for driver phone calls. Empty = Opus 5.5. Through OpenRouter use slugs like anthropic/claude-haiku-5.5
VOICE_MODEL=
# Optional: free lock-screen push for incoming calls via the ntfy app (pick a hard-to-guess topic)
NTFY_TOPIC=
# Optional: the public tunnel URL, so the push opens the driver page
PUBLIC_URL=

# Control room data: 1 (default) = checked fixtures, 0 = Lane B's agent store
USE_FIXTURES=1
